# Choose one: "anthropic" (default, needs an API key) or "ollama" (local, free, no key needed)
LLM_PROVIDER=ollama

# --- anthropic ---
ANTHROPIC_API_KEY=your-api-key-here
CLAUDE_MODEL=claude-sonnet-5

# --- ollama (local) ---
# Install from https://ollama.com/download, then: ollama pull llama3.1
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434
